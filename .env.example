NUXT_API_SECRET=api_secret_token
# ---- PostgreSQL 18 ----
NUXT_DATABASE_URL=postgres://app_user:app_password@localhost:5432/nuxt4_rbac
# ---- JWT ----
NUXT_JWT_ACCESS_SECRET=change-this-access-secret-in-production
NUXT_JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
NUXT_ACCESS_TOKEN_TTL=15m
NUXT_REFRESH_TOKEN_TTL_DAYS=7
# ---- Nitro ----
NUXT_NITRO_PORT=3000
NUXT_CDN_DIRECTORY=data

# 60000 = 1 minute, 0 = no timeout
# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL='https://app.yourdomain.com'
NUXT_PUBLIC_TIME_OUT=300000
NUXT_PUBLIC_API_DOMAIN='yourdomain.com'
NUXT_PUBLIC_API_BASE='/api'
NUXT_PUBLIC_CDN_BASE='/cdn'
NUXT_PUBLIC_API_CLIENT='default'
NUXT_PUBLIC_APP_VERSION='1.0.0'
NUXT_PUBLIC_CODE_VERSION=1
NUXT_PUBLIC_WEB_URL='https://app.yourdomain.com'
NUXT_PUBLIC_REFRESH_TOKEN_TTL_DAYS=7
